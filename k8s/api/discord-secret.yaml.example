# Discord OAuth credentials for the MineForge API.
# Copy to discord-secret.yaml, fill in values, then:
#   kubectl apply -f k8s/api/discord-secret.yaml
# Never commit the real file — it is in .gitignore.
#
# Discord app setup:
#   1. https://discord.com/developers/applications → New Application
#   2. OAuth2 → add redirect: https://<your-domain>/callback
#   3. Copy Client ID and Client Secret below
apiVersion: v1
kind: Secret
metadata:
  name: mineforge-discord
  namespace: minecraft
type: Opaque
stringData:
  DISCORD_CLIENT_ID: "CHANGE_ME"
  DISCORD_CLIENT_SECRET: "CHANGE_ME"
  DISCORD_REDIRECT_URI: "https://CHANGE_ME/callback"
  JWT_SECRET: "CHANGE_ME_random_32_char_string"
